# ── Environment ──
ENV=development

# ── Database ──
# REQUIRED: generate a strong password — never use the default here in prod
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DATABASE_URL=postgresql+asyncpg://honeywell:REPLACE_ME@db:5432/honeywell_sales
POSTGRES_DB=honeywell_sales
POSTGRES_USER=honeywell
POSTGRES_PASSWORD=REPLACE_ME

# ── Auth ──
# REQUIRED: python3 -c "import secrets; print(secrets.token_hex(32))"  # 64 hex chars
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEFAULT_ADMIN_EMAIL=admin@honeywell.com
# REQUIRED: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
DEFAULT_ADMIN_PASSWORD=

# ── CORS ──
CORS_ORIGINS=http://localhost,http://localhost:80

# ── Anthropic (Claude API - optional) ──
ANTHROPIC_API_KEY=

# ── Microsoft Graph API (optional) ──
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_USER_EMAIL=

# ── Notification Channels (Slack/Teams - optional) ──
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ── Internal email domains ──
INTERNAL_EMAIL_DOMAINS=honeywell.com

# ── SMTP (optional) ──
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# ── Company ──
COMPANY_NAME="Honeywell Turkey"

# ── Quote Defaults ──
QUOTE_PREFIX=HW-2026-
DEFAULT_TAX_RATE=20
DEFAULT_CURRENCY=TRY

# ── Rate Limiting ──
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute

# ── Security ──
MAX_UPLOAD_SIZE_MB=10

# ── Observability (Sentry — optional) ──
# Leave blank to disable error tracking. Get DSN from Sentry project settings.
SENTRY_DSN=
# Random string gating /api/debug/sentry-test. Set to verify delivery once,
# then clear to disable the endpoint. `python3 -c "import secrets; print(secrets.token_urlsafe(16))"`
SENTRY_TEST_TOKEN=
# Frontend Sentry DSN — separate Sentry project from backend.
VITE_SENTRY_DSN=
# Build identifier used as Sentry release tag. On Render this is auto-set to
# RENDER_GIT_COMMIT; on CI use GITHUB_SHA. Falls back to "dev".

# ── Feature flags (örnek; tam liste için projedeki .env şablonuna bakın) ──
FEATURE_BUYER_MAP=false

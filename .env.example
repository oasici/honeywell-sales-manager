# Honeywell Sales Suite — environment variable reference.
#
# Copy to ``.env`` and fill in the REQUIRED entries. Defaults are
# production-safe except where noted. Feature flags default to ``false``;
# see docs/feature-flags.md for what each flag enables and depends on.

# ── Environment ──
ENV=development                        # development | staging | production

# ── Database ──
# REQUIRED. Generate a strong password:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DATABASE_URL=postgresql+asyncpg://honeywell:REPLACE_ME@db:5432/honeywell_sales
POSTGRES_DB=honeywell_sales
POSTGRES_USER=honeywell
POSTGRES_PASSWORD=REPLACE_ME

# Dev convenience only — never enable in prod.
AUTO_CREATE_TABLES=false
AUTO_SCHEMA_SYNC=false

# ── Database Pool ──
# Sized for gunicorn -w 4. Total ceiling = workers * (pool + overflow).
# Defaults (20+10 = 30/worker → 120 total) assume max_connections >= 150.
# Render free tier has max_connections=97, drop to 10/5 there.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ── Redis (optional but strongly recommended) ──
# Empty value disables Redis; the app falls back to in-memory caches and
# in-memory rate limiting (per-worker, not shared). Token revocation,
# field-permission cache, deal-health cache, and AI summary cache all
# survive without Redis but degrade in some way.
REDIS_URL=redis://redis:6379/0

# ── Auth ──
# REQUIRED. Generate a 64-char hex secret:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bootstrap admin account on first run. Generate a strong password:
#   python3 -c "import secrets; print(secrets.token_urlsafe(18))"
DEFAULT_ADMIN_EMAIL=admin@honeywell.com
DEFAULT_ADMIN_PASSWORD=

# Per-row encryption key (KVKK PII columns). Auto-generated on first
# start in dev; MUST be set in prod so restarts don't lose decryption.
ENCRYPTION_KEY=

# ── CORS ──
# Comma-separated. Wildcards forbidden in production (see security.md).
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# ── Anthropic (Claude API) ──
# Required only when any FEATURE_AI_* flag is enabled.
ANTHROPIC_API_KEY=
AI_MODEL_NAME=claude-sonnet-4-20250514
AI_MAX_TOKENS=1024
AI_TEMPERATURE=1.0
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=30
AI_FALLBACK_STRATEGY=claude-first      # claude-first | regex-first

# ── Qdrant Vector DB ──
# Required when FEATURE_RAG=true.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_DEALS=deals
QDRANT_COLLECTION_INTERACTIONS=interactions
QDRANT_COLLECTION_COMPETITORS=competitors

# ── Microsoft Graph API (optional) ──
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_USER_EMAIL=
GRAPH_WEBHOOK_SECRET=

# ── Notification Channels (optional) ──
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ── Email Polling ──
INTERNAL_EMAIL_DOMAINS=honeywell.com,honeywell.com.tr
EMAIL_POLL_INTERVAL_MINUTES=5

# ── SMTP (optional) ──
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# ── Company ──
COMPANY_NAME="Honeywell Turkey"
COMPANY_ADDRESS="Istanbul, Turkey"
COMPANY_PHONE="+90 212 000 0000"
COMPANY_TAX_ID=

# ── Quote Defaults ──
QUOTE_PREFIX=HW-2026-
DEFAULT_TAX_RATE=20
DEFAULT_CURRENCY=TRY
QUOTE_VALIDITY_DAYS=30

# ── Filesystem ──
QUOTES_DIR=data/quotes
UPLOADS_DIR=data/uploads
TEMPLATES_DIR=app/templates

# ── Rate Limiting ──
RATE_LIMIT_LOGIN=5/minute              # per IP, brute-force protection
RATE_LIMIT_API=100/minute              # global default per route
RATE_LIMIT_AI=60/minute                # per user, Claude cost amplification protection
RATE_LIMIT_UPLOAD=10/minute            # per user, disk/memory pressure protection

# ── KVKK / Data Retention ──
# OFF by default. Flipping this true enables the daily 03:00 cron that
# anonymizes records past their retention threshold. Once anonymized,
# the data is unrecoverable — run the dry-run path first
# (docs/runbooks/kvkk-retention-anonymize.md).
KVKK_AUTO_ANONYMIZE_ENABLED=false
KVKK_EMAIL_RETENTION_DAYS=730          # 2 years
KVKK_OPPORTUNITY_RETENTION_DAYS=1095   # 3 years

# ── Security & Uploads ──
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls

# PDF parsing safety limits (DoS mitigation).
PDF_PARSE_TIMEOUT_SECONDS=12
PDF_PARSE_MAX_PAGES=12
PDF_PARSE_CONCURRENCY=2

# ── Observability (Sentry) ──
# Leave blank to disable error tracking. Get DSN from project settings.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Random string gating /api/debug/sentry-test. Set once to verify delivery,
# then clear to disable the endpoint:
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"
SENTRY_TEST_TOKEN=

# Comma-separated Sentry project IDs allowed to relay through
# /api/sentry-tunnel. Only the frontend project ID — prevents open-relay
# abuse. Find the ID in the frontend DSN path.
SENTRY_ALLOWED_PROJECT_IDS=

# Frontend Sentry DSN — separate Sentry project from backend.
VITE_SENTRY_DSN=

# ── E-Signature ──
ESIGN_TOKEN_EXPIRE_DAYS=7

# ── Feature Flags ─────────────────────────────────────────────────────
# Full reference: docs/feature-flags.md (auto-generated). Each flag
# defaults to ``false`` and depends on one or more of the env vars above.
# Flip to ``true`` only after the dependency is satisfied.

# RAG / Vector Search (depends on QDRANT_URL)
FEATURE_RAG=false

# Board & Pipeline (depends on DATABASE_URL)
FEATURE_V2_BOARD=false
FEATURE_TASKS=false

# AI features (depend on ANTHROPIC_API_KEY)
FEATURE_AI_SUMMARIES=false
FEATURE_AI_PIPELINE_SUGGESTIONS=false   # also depends on FEATURE_V2_BOARD
FEATURE_AI_TRIAGE=false
FEATURE_AI_DEAL_RISK=false
FEATURE_AI_COMPETITIVE_INTEL=false      # also depends on FEATURE_RAG
FEATURE_AI_PREDICTIONS=false

# Lead & Deal Management
FEATURE_LEAD_LIFECYCLE=false
FEATURE_DEAL_HEALTH=false               # depends on ANTHROPIC_API_KEY
FEATURE_GUIDED_SELLING=false            # depends on ANTHROPIC_API_KEY

# Revenue Operations
FEATURE_REVENUE_COCKPIT=false           # depends on ANTHROPIC_API_KEY

# Approval & Workflow
FEATURE_APPROVAL_ROUTING=false
FEATURE_WORKFLOW_RULES=false
FEATURE_BREACH_WORKFLOW=false

# Reporting & Dashboards
FEATURE_REPORT_BUILDER=false
FEATURE_DASHBOARD_BUILDER=false

# Access Control & Security
FEATURE_TEAM_ACCESS=false
FEATURE_FIELD_PERMISSIONS=false
FEATURE_SESSION_MANAGEMENT=false        # depends on REDIS_URL

# Integrations & API
FEATURE_WEBHOOKS=false
FEATURE_PUBLIC_API=false                # depends on JWT_SECRET_KEY

# Product & Configuration
FEATURE_PRODUCT_RULES=false
FEATURE_CUSTOM_FIELDS=false

# Progressive Web App
FEATURE_PWA=false

# Other modules
FEATURE_CAMPAIGNS=false
FEATURE_INVOICING=false
FEATURE_ESIGN=false
FEATURE_MULTI_PIPELINE=false
FEATURE_TERRITORIES=false
FEATURE_REV_REC=false
FEATURE_LIVE_CHAT=false
FEATURE_SEQUENCES_V2=false
FEATURE_BEHAVIORAL_SCORING=false        # depends on FEATURE_SEQUENCES_V2
FEATURE_BUYER_MAP=false

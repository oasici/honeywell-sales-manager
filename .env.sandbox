# ── Sandbox Environment ──
# Isolated test instance with all features enabled

# ── Database ──
POSTGRES_DB=sandbox_honeywell
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=sandbox_dev_2026!
DATABASE_URL=postgresql+asyncpg://sandbox:sandbox_dev_2026!@db-sandbox:5432/sandbox_honeywell

# ── Redis ──
REDIS_PASSWORD=sandbox_redis
REDIS_URL=redis://:sandbox_redis@redis-sandbox:6379/0

# ── Auth ──
JWT_SECRET_KEY=sandbox_jwt_secret_key_honeywell_sales_test_2026_min_32_chars
DEFAULT_ADMIN_EMAIL=admin@honeywell.com
DEFAULT_ADMIN_PASSWORD=Admin123!

# ── Environment ──
ENV=sandbox

# ── CORS ──
CORS_ORIGINS=http://localhost:8081,http://localhost:8001,http://localhost:5173

# ── Feature Flags (ALL ON for sandbox testing) ──
FEATURE_V2_BOARD=true
FEATURE_AI_SUMMARIES=true
FEATURE_AI_PIPELINE_SUGGESTIONS=true
FEATURE_LEAD_LIFECYCLE=true
FEATURE_APPROVAL_ROUTING=true
FEATURE_DEAL_HEALTH=true
FEATURE_WEBHOOKS=true
FEATURE_TEAM_ACCESS=true
FEATURE_REPORT_BUILDER=true
FEATURE_REVENUE_COCKPIT=true
FEATURE_AI_PREDICTIONS=true
FEATURE_WORKFLOW_RULES=true
FEATURE_AI_DEAL_RISK=true
FEATURE_AI_COMPETITIVE_INTEL=true
FEATURE_CUSTOM_FIELDS=true
FEATURE_FIELD_PERMISSIONS=true
FEATURE_PRODUCT_RULES=true
FEATURE_DASHBOARD_BUILDER=true
FEATURE_AI_TRIAGE=true
FEATURE_BREACH_WORKFLOW=true
FEATURE_PUBLIC_API=true
FEATURE_PWA=true
FEATURE_SESSION_MANAGEMENT=true
FEATURE_GUIDED_SELLING=true
FEATURE_RAG=true
FEATURE_CAMPAIGNS=true
FEATURE_INVOICING=true
FEATURE_ESIGN=true
FEATURE_MULTI_PIPELINE=true
FEATURE_TERRITORIES=true
FEATURE_REV_REC=true
FEATURE_LIVE_CHAT=true
FEATURE_SEQUENCES_V2=true
FEATURE_BEHAVIORAL_SCORING=true
FEATURE_BUYER_MAP=true

# ── Qdrant ──
QDRANT_URL=http://qdrant-sandbox:6333

# ── Scheduler ──
SCHEDULER_ENABLED=false
WEB_CONCURRENCY=2

# ── AI (optional for sandbox) ──
ANTHROPIC_API_KEY=

# ── Slack/Teams (disabled in sandbox) ──
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ── Company Info ──
COMPANY_NAME=Honeywell Turkey (Sandbox)
COMPANY_PHONE=+90 212 000 0000
